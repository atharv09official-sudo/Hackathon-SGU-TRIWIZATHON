# HETVAYA Environment Configuration Template
# Copy this file to .env for local overrides

# Application Mode
VITE_APP_ENV=development
VITE_APP_NAME="HETVAYA (हेत्वय)"

# MapLibre / Vector Tile Source (Optional: falls back to built-in SVG/Canvas routing)
# VITE_MAP_TILES_URL=https://demotiles.maplibre.org/style.json

# FlowGrid FastAPI Authoritative Backend Configuration
PROJECT_NAME="FlowGrid Authoritative Decision & Inventory System"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkeyforflowgriddevtestingonly"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL="sqlite:///./flowgrid_dev.db"

# Local Ollama LLM Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_FALLBACK_MODEL="gemma4:12b"
OLLAMA_TIMEOUT_SECONDS=30.0
OLLAMA_ENABLED=true

# Twilio SMS Notification Credentials (FR-P0-09)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
TWILIO_RECIPIENT_PHONE="+91xxxxxxxxxx"
